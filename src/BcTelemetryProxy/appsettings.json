{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otlp": {
    "//": "OTLP/HTTP base URL of the backend (e.g. GitLab Observability https://<id>.otel.gitlab-o11y.com:14318) or of an optional Collector. /v1/{logs,traces,metrics} is appended.",
    "Endpoint": "http://localhost:4318",
    "Headers": {},
    "Compression": true,
    "TimeoutSeconds": 30,
    "MaxQueueSize": 100000,
    "MaxBatchSize": 2000,
    "BatchDelayMilliseconds": 2000,
    "MaxRetrySeconds": 300
  },
  "Ingestion": {
    "MaxCompressedRequestBytes": 10485760,
    "MaxDecompressedRequestBytes": 104857600,
    "MaxEnvelopeBytes": 1048576,
    "MaxEnvelopesPerRequest": 10000
  },
  "Resource": {
    "//": "Defaults for every source. Host and BC instance come from the ingestion URL (/<host>/<instance>/v2/track); Sources overrides per 'host/instance', 'instance' or 'host'.",
    "ServiceName": "business-central",
    "ServiceNamespace": "dynamics365-bc",
    "DeploymentEnvironment": "production",
    "HostName": null,
    "BcServerInstance": null,
    "Sources": {}
  },
  "Telemetry": {
    "AllowedAttributes": [],
    "DeniedAttributes": [],
    "RedactedAttributes": [
      "password",
      "authorization",
      "accessToken"
    ],
    "HashedAttributes": [
      "enduser.id"
    ],
    "RedactionMarker": "[REDACTED]"
  }
}
