{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otlp": {
    "//": "OTLP/HTTP endpoint of the local OpenTelemetry Collector, which forwards to the observability backend.",
    "Endpoint": "http://localhost:4318"
  },
  "Ingestion": {
    "MaxCompressedRequestBytes": 10485760,
    "MaxDecompressedRequestBytes": 104857600,
    "MaxEnvelopeBytes": 1048576,
    "MaxEnvelopesPerRequest": 10000
  },
  "Metrics": {
    "MaxInstruments": 500
  },
  "Resource": {
    "ServiceName": "business-central",
    "ServiceNamespace": "dynamics365-bc",
    "ServiceInstanceId": null,
    "DeploymentEnvironment": "production",
    "HostName": null,
    "BcServerInstance": null,
    "BcTenantId": null
  },
  "Telemetry": {
    "AllowedAttributes": [],
    "DeniedAttributes": [],
    "RedactedAttributes": [
      "password",
      "authorization",
      "accessToken"
    ],
    "HashedAttributes": [
      "enduser.id"
    ],
    "RedactionMarker": "[REDACTED]"
  }
}
